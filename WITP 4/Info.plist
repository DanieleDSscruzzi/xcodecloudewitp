<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Scene: l'app normale (gestita da SwiftUI) più quella CarPlay.
         La scena principale non va dichiarata: con il ciclo di vita
         SwiftUI la fornisce il sistema. Qui si aggiunge SOLO CarPlay. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <!-- Scena principale dell'app. Va dichiarata a mano perché la
                 generazione automatica è disattivata: senza generazione,
                 un manifest che contiene SOLO CarPlay lascerebbe l'app
                 normale senza finestra. Il delegate è quello di SwiftUI
                 (nessuna classe indicata = lo fornisce il sistema). -->
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                </dict>
            </array>

            <key>CPTemplateApplicationSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneClassName</key>
                    <string>CPTemplateApplicationScene</string>
                    <key>UISceneConfigurationName</key>
                    <string>WITP-CarPlay</string>
                    <key>UISceneDelegateClassName</key>
                    <string>WITPCarPlaySceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>it</string>

    <key>CFBundleDisplayName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundleName</key>
    <string>WITP</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <!-- Versione e build: governate da Xcode (General → Identity).
         NON scriverle a mano qui, altrimenti il numero resta bloccato
         e App Store Connect rifiuta la build. -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>

    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Asset catalog icon name (richiesto da iOS 11+) -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>

    <!-- Posizione -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>WITP usa la tua posizione per trovare parcheggi vicino a te con la pipeline WDSL+.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>WITP può monitorare la posizione in background per avvisarti quando stai per scadere la sosta.</string>

    <!-- Notifiche -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>fetch</string>
        <string>processing</string>
    </array>

    <!-- Obbligatorio quando UIBackgroundModes contiene 'processing':
         va dichiarato l'elenco degli identificatori dei task in background,
         altrimenti App Store Connect rifiuta il binario (ITMS-90771). -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.danielescruzzi.witp.refresh</string>
        <string>com.danielescruzzi.witp.processing</string>
    </array>

    <!-- Mappe -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>maps</string>
        <string>comgooglemaps</string>
    </array>

    <!-- Launch & UI -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>

    <!-- Apple Silicon required features (performance hints) -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>metal</string>
        <string>location-services</string>
    </array>
</dict>
</plist>
