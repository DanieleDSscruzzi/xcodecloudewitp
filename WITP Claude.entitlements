<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.danielescruzzi.witp</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- CarPlay per app di parcheggio. Apple deve APPROVARE questa
	     capability prima che funzioni: si richiede su
	     developer.apple.com/contact/carplay (vedi CARPLAY.md).
	     Finché non è approvata, questa riga fa fallire la firma:
	     tienila commentata se devi compilare prima dell'ok. -->
	<!-- CarPlay per app di parcheggio. Se la firma fallisce con
	     "requires approval from Apple", significa che la capability non è
	     ancora abbinata a questo bundle ID: premi "Request Access…" in
	     Signing & Capabilities e ricommenta queste due righe nel frattempo. -->
	<key>com.apple.developer.carplay-parking</key>
	<true/>
</dict>
</plist>
